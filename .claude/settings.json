{
  "permissions": {
    "allow": [
      "DesignSync"
    ]
  },
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/command-history.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/flow-tracker.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/advise-tracker.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Update|ApplyPatch|DesignSync|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/guards/advise-guard.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/hooks/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "humanizer@humanizer": true,
    "gopls-lsp@claude-plugins-official": true,
    "caveman@caveman": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "pstack@cursor-plugins": true
  },
  "extraKnownMarketplaces": {
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "cursor-plugins": {
      "source": {
        "source": "directory",
        "path": "/home/talinux/.claude/marketplaces/cursor-plugins"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen"
}
