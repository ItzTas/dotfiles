{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent",
    "opencode-notify",
    "opencode-dynamic-context-pruning",
    "opencode-vibeguard"
  ],
  "mcp": {
    "clickup": {
      "type": "remote",
      "url": "https://mcp.clickup.com/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "claude-design": {
      "type": "remote",
      "url": "https://api.anthropic.com/v1/design/mcp",
      "enabled": true
    }
  }
}