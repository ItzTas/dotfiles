[Desktop Entry]
Name=nmtui Hypr
Comment=Network Manager TUI for Hyprland
Exec=hyprctl eval 'hl.exec_cmd("kitty -o cursor_trail=0 -o background_opacity=0 -e nmtui", { float = true, no_anim = true, no_blur = false, center = true })'
Icon=network-wireless
Terminal=false
Type=Application
OnlyShowIn=Hyprland;
Categories=Network;Utility;
